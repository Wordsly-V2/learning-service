# ── learning-service ──────────────────────────────────────────────────────
# Copy to `.env` and fill in. Vars marked (required) are validated at boot
# (src/config/validate-env.ts) — the service will refuse to start without them.

# HTTP port (defaults to 3003).
PORT=3003

# Comma-separated list of allowed CORS origins.
CORS_ENABLED_ORIGINS=http://localhost:4000

# (required) PostgreSQL connection string.
DATABASE_URL=postgresql://wordsly:wordsly@localhost:5432/learning?schema=public

# Redis connection string (optional).
REDIS_URL=redis://localhost:6379

# (required) Shared secret for gateway → learning-service internal calls.
INTERNAL_SERVICE_TO_SERVICE_TOKEN=

# ── Kafka (optional; leave empty to disable) ──────────────────────────────────
KAFKA_BROKERS=
KAFKA_CA=
KAFKA_CERT=
KAFKA_KEY=

# ── Web Push / VAPID (optional; leave empty to disable push) ──────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@wordsly.app
