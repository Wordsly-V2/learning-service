generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Spaced repetition tracking using SM-2 algorithm.
// wordId references vocabulary-service words (no cross-DB FK).
model WordProgress {
  id          String @id @db.Uuid
  wordId      String @db.Uuid
  userLoginId String @db.Uuid

  easeFactor  Float @default(2.5)
  interval    Int   @default(0)
  repetitions Int   @default(0)

  lastReviewedAt DateTime? @map("last_reviewed_at") @db.Timestamptz
  nextReviewAt   DateTime  @default(now()) @map("next_review_at") @db.Timestamptz

  totalReviews   Int @default(0) @map("total_reviews")
  correctReviews Int @default(0) @map("correct_reviews")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([wordId, userLoginId])
  @@index([userLoginId, nextReviewAt])
  @@index([wordId])
  @@map("word_progress")
}
