generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Spaced repetition tracking (FSRS via ts-fsrs).
// wordId references vocabulary-service words (no cross-DB FK).
model WordProgress {
  id          String @id @db.Uuid
  wordId      String @db.Uuid
  userLoginId String @db.Uuid

  easeFactor  Float @default(2.5) // FSRS difficulty
  interval    Int   @default(0) // scheduled days until next review
  repetitions Int   @default(0) // total FSRS reps — increments on every review, including failures
  stability   Float @default(0) // FSRS memory stability; 0 = derive from interval on read (legacy SM-2 row)

  // Consecutive correct answers, reset by any wrong answer. Tracked separately
  // because `repetitions` (ts-fsrs `card.reps`) counts failures too.
  correctStreak Int @default(0) @map("correct_streak")

  // Full FSRS card state persisted so the scheduler reconstructs the card
  // losslessly instead of inferring it (lapse history + learning step survive).
  state         Int @default(0) @map("fsrs_state") // FSRS State enum: 0=New 1=Learning 2=Review 3=Relearning
  lapses        Int @default(0) // times the card lapsed (Again on a Review card)
  learningSteps Int @default(0) @map("learning_steps") // index into FSRS learning/relearning steps

  lastReviewedAt DateTime? @map("last_reviewed_at") @db.Timestamptz
  nextReviewAt   DateTime  @default(now()) @map("next_review_at") @db.Timestamptz

  totalReviews   Int @default(0) @map("total_reviews")
  correctReviews Int @default(0) @map("correct_reviews")

  // Leech handling: a card that has lapsed past the user's threshold *since its
  // last rescue* is flagged (computed on write) so it can be listed/remediated;
  // suspended cards are withheld from due-word selection until manually
  // unsuspended or re-answered. See src/word-progress/leech.logic.ts.
  isLeech     Boolean   @default(false) @map("is_leech")
  suspendedAt DateTime? @map("suspended_at") @db.Timestamptz

  // Rescue baseline: lifetime `lapses` at the moment the card was last rescued,
  // so the leech rule measures lapses since then rather than forever. 0 = never
  // rescued, which makes the rule identical to the original lifetime one.
  lapsesAtRescue Int @default(0) @map("lapses_at_rescue")
  rescuedCount   Int @default(0) @map("rescued_count")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([wordId, userLoginId])
  @@index([userLoginId, nextReviewAt])
  @@index([userLoginId, isLeech])
  @@index([wordId])
  @@map("word_progress")
}

// Daily practice goal and streak (one row per user).
model DailyHabit {
  userLoginId String @id @map("user_login_id") @db.Uuid

  dailyGoal         Int @default(10) @map("daily_goal")
  wordsToday        Int @default(0) @map("words_today")
  streak            Int @default(0)
  longestStreak     Int @default(0) @map("longest_streak")
  goalStreak        Int @default(0) @map("goal_streak")
  longestGoalStreak Int @default(0) @map("longest_goal_streak")
  practiceDate      DateTime  @map("practice_date") @db.Date
  lastPracticeDate  DateTime? @map("last_practice_date") @db.Date
  lastGoalMetDate   DateTime? @map("last_goal_met_date") @db.Date

  totalWordsPracticed Int @default(0) @map("total_words_practiced")
  totalPracticeDays   Int @default(0) @map("total_practice_days")

  streakFreezes      Int       @default(0) @map("streak_freezes")
  lastFreezeUsedDate DateTime? @map("last_freeze_used_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  days DailyHabitDay[]

  @@map("daily_habit")
}

// Per-day review-accuracy aggregate (one row per user per day).
// Written incrementally on each recorded answer so the progress report can
// chart accuracy/improvement over time without scanning the per-word table.
// Volume/consistency come from DailyHabitDay; this adds the correctness signal.
model DailyReviewStat {
  userLoginId    String   @map("user_login_id") @db.Uuid
  reviewDate     DateTime @map("review_date") @db.Date
  reviews        Int      @default(0) // total answers recorded that day
  correctReviews Int      @default(0) @map("correct_reviews")
  newWords       Int      @default(0) @map("new_words") // words first seen that day

  @@id([userLoginId, reviewDate])
  @@index([userLoginId, reviewDate(sort: Desc)])
  @@map("daily_review_stat")
}

// Cumulative XP and derived learning level (one row per user, lazily created).
// XP is written from two domains in their own transactions — per-answer learning
// XP (word-progress) and consistency XP (daily-habit) — so it lives on its own
// row that both can increment atomically, mirroring DailyReviewStat.
model UserLevel {
  userLoginId String @id @map("user_login_id") @db.Uuid

  totalXp Int @default(0) @map("total_xp")
  // Denormalized cache of levelFromXp(totalXp); recomputed on every write so it
  // can't drift. totalXp stays the source of truth. Persisted so a level-up can
  // be detected by comparing pre/post level within the same transaction.
  level Int @default(1)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("user_level")
}

// Per-day activity log for history and weekly stats.
model DailyHabitDay {
  userLoginId    String   @map("user_login_id") @db.Uuid
  practiceDate   DateTime @map("practice_date") @db.Date
  wordsPracticed Int      @default(0) @map("words_practiced")
  goalMet        Boolean  @default(false) @map("goal_met")

  habit DailyHabit @relation(fields: [userLoginId], references: [userLoginId], onDelete: Cascade)

  @@id([userLoginId, practiceDate])
  @@index([userLoginId, practiceDate(sort: Desc)])
  @@map("daily_habit_day")
}

// An achievement a user has unlocked (persisted, unlike the derived progress
// grid in the learning report). Detected at write-time in daily-habit so the
// unlock moment can be celebrated and rewarded exactly once.
model UserAchievement {
  userLoginId String   @map("user_login_id") @db.Uuid
  key         String // e.g. "streak-7", "words-250", "days-30"
  unlockedAt  DateTime @default(now()) @map("unlocked_at") @db.Timestamptz
  xpAwarded   Int      @default(0) @map("xp_awarded")

  @@id([userLoginId, key])
  @@index([userLoginId, unlockedAt(sort: Desc)])
  @@map("user_achievement")
}

// Per-user push notification opt-in and reminder preferences (one row per user).
// timezone is IANA (e.g. Asia/Ho_Chi_Minh); reminderTime is "HH:mm" user-local.
// lastReminderSentDate is a user-local @db.Date used to dedupe daily reminders.
model NotificationPreference {
  userLoginId           String    @id @map("user_login_id") @db.Uuid
  streakReminderEnabled Boolean   @default(false) @map("streak_reminder_enabled")
  reminderTime          String    @default("19:00") @map("reminder_time")
  timezone              String    @default("UTC")
  lastReminderSentDate  DateTime? @map("last_reminder_sent_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("notification_preference")
}

// A Web Push subscription (one row per browser/device endpoint).
model PushSubscription {
  id          String   @id @db.Uuid
  userLoginId String   @map("user_login_id") @db.Uuid
  endpoint    String   @unique
  p256dh      String
  auth        String
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([userLoginId])
  @@map("push_subscription")
}

// Per-user learning pacing + leech configuration (one row per user, lazily
// created like UserLevel). Read by word-progress to cap daily new words/reviews
// and to decide when a lapsing card becomes a leech.
model UserLearningSettings {
  userLoginId       String  @id @map("user_login_id") @db.Uuid
  dailyNewWordLimit Int     @default(10) @map("daily_new_word_limit")
  dailyReviewLimit  Int     @default(100) @map("daily_review_limit")
  leechThreshold    Int     @default(8) @map("leech_threshold")
  leechAutoSuspend  Boolean @default(false) @map("leech_auto_suspend")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("user_learning_settings")
}

// Per-user app/UI preferences synced across devices (one row per user, lazily
// created). Stored as an opaque JSON blob — the shape is owned by the frontend
// (practice settings, due-words batch size, word-details auto-advance, theme).
// PATCH shallow-merges into `preferences` so writes are last-write-wins per key.
model UserPreferences {
  userLoginId String @id @map("user_login_id") @db.Uuid
  preferences Json   @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("user_preferences")
}

// Idempotency ledger for client-replayed writes (offline sync flushes). The
// client mints one UUID per flush; a retry after a lost response finds the row
// and gets the ORIGINAL response back instead of re-applying XP and FSRS.
// `response` is null while the work is in flight, which is how a losing racer
// distinguishes "still running" (409, retry shortly) from "done" (replay).
// Scoped by userLoginId so one user's ids can never collide with another's.
model SyncRequest {
  userLoginId     String   @map("user_login_id") @db.Uuid
  clientRequestId String   @map("client_request_id") @db.Uuid
  endpoint        String
  response        Json?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([userLoginId, clientRequestId])
  @@index([createdAt])
  @@map("sync_request")
}

// One-shot per-day consistency XP grants. The PK is the idempotency guarantee:
// a replayed flush, a backdated day arriving late, or two racing batches can
// each pay "first practice of 2026-08-11" at most once, ever.
model DailyHabitGrant {
  userLoginId  String   @map("user_login_id") @db.Uuid
  practiceDate DateTime @map("practice_date") @db.Date
  kind         String
  xpAwarded    Int      @map("xp_awarded")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([userLoginId, practiceDate, kind])
  @@map("daily_habit_grant")
}
